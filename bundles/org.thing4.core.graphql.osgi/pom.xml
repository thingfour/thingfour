<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/maven-v4_0_0.xsd">

  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>org.thing4</groupId>
    <artifactId>bundles</artifactId>
    <version>3.0.0-SNAPSHOT</version>
    <relativePath>../pom.xml</relativePath>
  </parent>

  <artifactId>org.thing4.core.graphql.osgi</artifactId>
  <packaging>bundle</packaging>

  <name>Thing4 - Core - GrapqhQL - OSGi</name>
  <description>Core OSGi framework GraphQL.</description>

  <dependencies>
    <dependency>
      <groupId>org.thing4</groupId>
      <artifactId>org.thing4.core.graphql</artifactId>
      <version>${project.version}</version>
    </dependency>

    <dependency>
      <groupId>org.osgi</groupId>
      <artifactId>org.osgi.service.component.annotations</artifactId>
    </dependency>
    <dependency>
      <groupId>org.osgi</groupId>
      <artifactId>osgi.core</artifactId>
    </dependency>
    <dependency>
      <groupId>org.osgi</groupId>
      <artifactId>osgi.cmpn</artifactId>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>io.github.kobylynskyi</groupId>
        <artifactId>graphql-codegen-maven-plugin</artifactId>
        <version>5.9.0</version>
        <executions>
          <execution>
            <goals>
              <goal>generate</goal>
            </goals>
            <configuration>
              <!--
              <typesAsInterfaces>Bundle</typesAsInterfaces>
              -->
              <graphqlSchemas>
                <includePattern>.*\.graphqls</includePattern>
              </graphqlSchemas>
              <addGeneratedAnnotation>false</addGeneratedAnnotation>
              <modelValidationAnnotation>java.lang.annotation.Native</modelValidationAnnotation>
              <outputDir>${project.build.directory}/generated-sources</outputDir>
              <apiPackageName>org.thing4.core.graphql.osgi.api</apiPackageName>
              <modelPackageName>org.thing4.core.graphql.osgi.model</modelPackageName>
              <packageName>org.thing4.core.graphql.osgi.model</packageName>
              <customTypesMapping>
                <DateTime>java.util.Date</DateTime>
                <Long>java.lang.Long</Long>
              </customTypesMapping>
              <customAnnotationsMapping>
                <EpochMillis>
                  <annotation>com.fasterxml.jackson.databind.annotation.JsonDeserialize(using =
                    com.example.json.EpochMillisScalarDeserializer.class)</annotation>
                </EpochMillis>
              </customAnnotationsMapping>
              <modelNameSuffix>TO</modelNameSuffix>
            </configuration>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>

</project>
