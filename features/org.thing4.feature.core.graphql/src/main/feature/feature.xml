<features name="thing4-misc-graphql-${project.version}"
  xmlns="http://karaf.apache.org/xmlns/features/v1.6.0">

  <feature name="openhab-misc-thing4-graphql" description="GraphQL interface" version="${project.version}">
    <feature>thing4-misc-graphql</feature>
  </feature>

  <feature name="thing4-misc-graphql" description="GraphQL Service" version="${project.version}">
    <feature prerequisite="true">wrap</feature>
    <feature dependency="true">openhab-runtime-base</feature>
    <feature dependency="true">openhab.tp-jackson</feature>

<!--    <bundle dependency="true">mvn:org.antlr/antlr4-runtime/4.7.2</bundle>-->
    <bundle>mvn:org.reactivestreams/reactive-streams/${reactive-streams.version}</bundle>
    <bundle>wrap:mvn:com.graphql-java/graphql-java/${graphql.version}$overwrite=merge&amp;Export-Package=graphql.*;version="${graphql.version}&amp;Import-Package=!java.*,!com.google.errorprone.annotations.*,!javax.annotation.meta,*""</bundle>
    <bundle>wrap:mvn:com.graphql-java/graphql-java-extended-scalars/${graphql-scalars.version}$overwrite=merge&amp;Export-Package=graphql.scalars*;version="${graphql-scalars.version}&amp;Import-Package=!java.*,*"</bundle>
    <bundle>mvn:com.graphql-java/java-dataloader/${graphql-dataloader.version}</bundle>
    <bundle>mvn:com.fasterxml.jackson.datatype/jackson-datatype-jdk8/2.10.3</bundle>
    <bundle start-level="80">mvn:org.thing4/org.thing4.core.graphql/${project.version}</bundle>
    <bundle start-level="80">mvn:org.thing4/org.thing4.core.graphql.osgi/${project.version}</bundle>
  </feature>

</features>
